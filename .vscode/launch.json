{
    // Launch configurations for the example app. They run on whichever device
    // is selected in the editor (Android, iOS or Chrome).
    "version": "0.2.0",
    "configurations": [
        {
            "name": "example",
            "request": "launch",
            "type": "dart",
            "program": "example/lib/main.dart"
        },
        {
            "name": "example (profile mode)",
            "request": "launch",
            "type": "dart",
            "program": "example/lib/main.dart",
            "flutterMode": "profile"
        },
        {
            "name": "example (release mode)",
            "request": "launch",
            "type": "dart",
            "program": "example/lib/main.dart",
            "flutterMode": "release"
        }
    ]
}
